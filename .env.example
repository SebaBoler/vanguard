# Auth: pick one. Subscription is the default and draws on your Claude plan's usage
# allowance (no per-token charge). Get the token once with `claude setup-token`, then
# store it in your vault.
CLAUDE_CODE_OAUTH_TOKEN=

# API billing instead of the subscription. Requires funds on platform.claude.com.
# Vanguard injects only one of these into the sandbox; the OAuth token takes priority.
ANTHROPIC_API_KEY=

# z.ai GLM Coding Plan (https://z.ai). Select with --provider zai: the Claude Code CLI is pointed
# at z.ai's Anthropic-compatible coding endpoint (https://api.z.ai/api/coding/paas/v4), so NO
# Anthropic token is required when using zai. Under --llm-proxy the key is held by the sidecar.
ZAI_API_KEY=

# Log level: trace, debug, info, warn, error
VANGUARD_LOG_LEVEL=info

# Linear task source (or run `linear auth login`)
LINEAR_API_KEY=

# GitHub: PAT for the gh CLI (GitHub source, opening PRs, git push). Or use `gh auth login` locally.
GH_TOKEN=

# Fine-grained PAT (Contents: Read and write) used by the revise flow to push revision commits so
# the resulting `synchronize` event triggers CI — works around the GITHUB_TOKEN recursion guard
# that suppresses workflow triggers for pushes made with the Actions-provided token. Optional:
# falls back to the default credential when unset.
VANGUARD_PUSH_TOKEN=

# Decision model (see README "Models"): the log-only difficulty probe (needs VANGUARD_DECISION_PROBE=1;
# white-label runs need `all`), `--fork-scorer decision` and `eval --judge-model clef-flash` share these
# credentials. Each sends its state (issue text / diff / eval output) from the HOST to the endpoint.
# VANGUARD_DECISION_PROBE=1
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AUTH_TOKEN=
# VANGUARD_DECISION_MODEL=clef-flash          # or clef
# VANGUARD_DECISION_URL=                      # any System-One-compatible endpoint instead of Workers AI
# VANGUARD_DECISION_TOKEN=
