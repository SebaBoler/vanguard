%% One run: the topology behind run-pipeline-light.svg / run-pipeline-dark.svg (README "How it works").
%% Change it here first, mirror it in run-pipeline.archify.json, then re-render with archify (github.com/tt-a1i/archify):
%%   node archify/bin/archify.mjs deliver architecture docs/diagrams/run-pipeline.archify.json <out>.html --quality showcase
%% Open <out>.html → Export → SVG, then: docs/diagrams/split-theme.sh <export>.svg run-pipeline
flowchart LR
  subgraph host[Host: CI job or watch loop]
    triage{"Claim + triage<br/>no model call"}
    info["needs info<br/>too vague, no spend"]
    scan{"Secret scan<br/>hit: nothing pushed"}
    pr["Push + open PR/MR<br/>red: draft, verify-failed"]
  end
  subgraph sandbox[Agent in Docker sandbox]
    implement["Implement<br/>writes the change"]
    review["Review<br/>Codex, fresh context"]
    simplify["Simplify<br/>fresh context"]
    verify{"Verify<br/>verify script or tests"}
    repair["Repair<br/>2nd: stronger model"]
  end

  triage --> info
  triage --> implement --> review --> simplify --> verify
  verify -->|red, max 2| repair -->|re-verify| verify
  verify -->|green, or repairs used up| scan --> pr
