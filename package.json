{
  "name": "vanguard",
  "version": "1.11.0",
  "main": "dist/index.js",
  "bin": {
    "vanguard": "dist/cli/index.js"
  },
  "scripts": {
    "start": "pnpm --dir apps/desktop start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:desktop": "pnpm --dir apps/desktop test",
    "lint": "eslint 'src/**/*.ts'",
    "build": "tsc && cp src/mcp/typecheck-server.mjs dist/mcp/typecheck-server.mjs && cp src/sandbox/egress-proxy-server.mjs dist/sandbox/egress-proxy-server.mjs && cp src/sandbox/egress-allow.mjs dist/sandbox/egress-allow.mjs && cp src/sandbox/llm-proxy-server.mjs dist/sandbox/llm-proxy-server.mjs && cp src/sandbox/llm-proxy-rewrite.mjs dist/sandbox/llm-proxy-rewrite.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage",
    "eval": "tsx src/cli/index.ts eval",
    "hub": "tsx src/cli/index.ts hub",
    "build:ui": "pnpm --dir apps/desktop install --frozen-lockfile && pnpm --dir apps/desktop build",
    "pricing:check": "tsx scripts/check-openrouter-pricing.ts",
    "dev": "tsx",
    "sbom": "bash docker/sbom.sh",
    "clean": "rm -rf dist && (test ! -d .vanguard || find .vanguard -mindepth 1 -maxdepth 1 ! -name approver.json -exec rm -rf {} +)",
    "gen:wire": "tsx scripts/gen-desktop-wire.ts"
  },
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@modelcontextprotocol/sdk": "^1.32.1"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@cdktf/hcl2json": "0.21.0",
    "execa": "^10.1.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
